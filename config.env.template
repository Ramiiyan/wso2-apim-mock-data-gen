# ============================================================
# WSO2 APIM Mock Data Generator - Configuration Template
# ============================================================
# Copy this file to config.env and fill in your values:
#   cp config.env.template config.env
#
# config.env is git-ignored — never commit it.
# ============================================================

# Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"

# Host Configuration
HOST="localhost"           # WSO2 APIM hostname or IP
SERVLET_PORT="9443"        # Management / servlet port
GATEWAY_PORT="8243"        # Gateway port

# Base64-encoded basic auth — auto-computed, do not edit
BASIC_AUTH=$(printf "%s" "$ADMIN_USERNAME:$ADMIN_PASSWORD" | base64)

# OAuth Scopes (do not change unless you know what you're doing)
PUBLISHER_SCOPE="apim:api_create apim:api_view apim:api_publish apim:api_import_export"
SUBSCRIBER_SCOPE="apim:api_view apim:subscribe apim:api_key apim:app_manage apim:sub_manage apim:store_settings apim:sub_alert_manage apim:app_import_export"

# Number of test applications to create in the Developer Portal
NUM_APPS=15

# Key Manager ID (use "Resident Key Manager" for the default setup)
KEY_MANAGER_ID="Resident Key Manager"

# ============================================================
# The following credentials are auto-generated by the scripts.
# Leave them blank here — they will be written to config.env
# automatically when api_creator.sh and devportal_app_creator.sh run.
# ============================================================
PUBLISHER_CLIENT_ID=""
PUBLISHER_CLIENT_SECRET=""
SUBSCRIBER_CLIENT_ID=""
SUBSCRIBER_CLIENT_SECRET=""
